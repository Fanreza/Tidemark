# ─────────────────────────────────────────────────────────────────────────────
# Tidemark — Environment Variables
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
#
# Nuxt maps these to runtimeConfig (see nuxt.config.ts):
#   NUXT_<KEY>          → runtimeConfig.<key>          (server-only, secret)
#   NUXT_PUBLIC_<KEY>   → runtimeConfig.public.<key>   (exposed to the browser)
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Supabase) ──────────────────────────────────────────────────────
# Optional. If BOTH are unset, Tidemark falls back to an in-memory store
# (data is lost on server restart) — fine for local demos.
# Get these from: Supabase → Project Settings → API.
# IMPORTANT: the service key bypasses Row Level Security — keep it server-side only.
NUXT_SUPABASE_URL=
NUXT_SUPABASE_SERVICE_KEY=

# ── Sui network ──────────────────────────────────────────────────────────────
# testnet | mainnet | devnet  (Tidemark is built and tested on testnet).
NUXT_PUBLIC_SUI_NETWORK=testnet

# ── Walrus decentralized storage ─────────────────────────────────────────────
# Defaults point at the public Walrus testnet endpoints (no auth required).
NUXT_PUBLIC_WALRUS_PUBLISHER=https://publisher.walrus-testnet.walrus.space
NUXT_PUBLIC_WALRUS_AGGREGATOR=https://aggregator.walrus-testnet.walrus.space

# ── Tatum (Sui RPC infrastructure) ───────────────────────────────────────────
# Optional. Reserved for future RPC use — not required for current features.
NUXT_TATUM_API_KEY=
